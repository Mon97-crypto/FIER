# Copy to .env and fill in. Every value is optional for local prototyping.
PORT=3000

# Google Sign-In (Gmail login). Create an OAuth 2.0 Web client at
# https://console.cloud.google.com/apis/credentials and add your site origin
# (e.g. http://localhost:3000) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Allow a no-Google "demo login" (defaults to true only when GOOGLE_CLIENT_ID is empty)
ALLOW_DEMO_LOGIN=

# Razorpay (UPI / cards / netbanking). Leave empty to use the simulated "demo pay".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Long random string used to sign login cookies. Auto-generated into data/ if empty.
SESSION_SECRET=

# Persistent storage for serverless hosting (Vercel → Marketplace → Upstash for Redis sets these).
# Leave empty locally to use data/db.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Key for /admin (order management + DTF artwork downloads). Printed at startup if empty.
ADMIN_KEY=

# Delivery-tracking simulation: minutes between each stage (0 disables auto-advance)
TRACKING_SIMULATION_MINUTES=2

# Secure cookies (defaults to true on Vercel)
COOKIE_SECURE=
