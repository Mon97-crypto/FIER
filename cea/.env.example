# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
PORT=3000

# Durable storage for saved simulations. In Vercel: Storage → Marketplace → "Upstash for Redis"
# → connect it to this project, and these are set for you. Leave empty locally to use data/simulations.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: cap on how many simulations can be stored (the app is open to everyone).
CEA_MAX_SIMULATIONS=1000
